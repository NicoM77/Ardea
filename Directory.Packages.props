<Project>
  <!--
    Central package management. Every new dependency needs a reason in its pull request,
    and its licence must be on the allow-list in build/licenses/ (master plan 13.5).
    Excluded for licence reasons: MediatR, AutoMapper, MassTransit >= 9, FluentAssertions >= 8,
    ImageSharp, Duende IdentityServer, TickerQ (checked by build/check-banned-packages.sh).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Platform">
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <PackageVersion Include="Anthropic" Version="13.10.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Catalog">
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
  </ItemGroup>
</Project>
