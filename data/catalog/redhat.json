{
  "$schema": "../catalog.schema.json",
  "vendor": "Red Hat",
  "products": [
    {
      "key": "rhel",
      "name": "Red Hat Enterprise Linux",
      "kind": "os",
      "versionScheme": "numeric",
      "cpe": ["redhat:enterprise_linux"],
      "aliases": [
        { "vendor": "Red Hat", "names": ["RHEL", "Red Hat Enterprise Linux {line}", "Red Hat Enterprise Linux {line} for {platform}"] }
      ],
      "images": ["registry.access.redhat.com/ubi9/ubi", "registry.access.redhat.com/ubi8/ubi"]
    },
    {
      // A distribution package: versions follow the distribution's builds, compared as RPM.
      "key": "rhel/openssl",
      "name": "openssl (Red Hat Enterprise Linux package)",
      "kind": "library",
      "versionScheme": "rpm",
      "cpe": ["redhat:openssl"],
      "packages": ["pkg:rpm/redhat/openssl"],
      "platform": "rhel",
      "related": ["openssl"]
    },
    {
      "key": "centos",
      "name": "CentOS",
      "kind": "os",
      "versionScheme": "numeric",
      "cpe": ["centos:centos"],
      "aliases": [
        { "names": ["CentOS Linux", "CentOS Stream"] },
        { "vendor": "CentOS", "names": ["CentOS {line}"] }
      ],
      "related": ["rhel"],
      "images": ["centos", "quay.io/centos/centos"]
    },
    {
      "key": "fedora",
      "name": "Fedora",
      "kind": "os",
      "versionScheme": "numeric",
      "cpe": ["fedoraproject:fedora"],
      "aliases": [
        { "names": ["Fedora Linux"] },
        { "vendor": "Fedora Project", "names": ["Fedora {line}"] }
      ],
      "images": ["fedora"]
    },
    {
      "key": "openshift",
      "name": "Red Hat OpenShift Container Platform",
      "kind": "container",
      "versionScheme": "numeric",
      "cpe": ["redhat:openshift_container_platform", "redhat:openshift"],
      "aliases": [
        { "vendor": "Red Hat", "names": ["OpenShift", "OpenShift Container Platform", "Red Hat OpenShift Container Platform {line}"] }
      ],
      "related": ["kubernetes"]
    },
    {
      "key": "podman",
      "name": "Podman",
      "kind": "container",
      "versionScheme": "go",
      "packages": ["pkg:golang/github.com/containers/podman/v4", "pkg:golang/github.com/containers/podman/v5"],
      "aliases": [{ "vendor": "containers", "names": ["Podman"] }],
      "images": ["quay.io/podman/stable"]
    },
    {
      // A CNCF project; the records come from Red Hat.
      "key": "keycloak",
      "name": "Keycloak",
      "kind": "other",
      "versionScheme": "numeric",
      "cpe": ["redhat:keycloak"],
      "packages": ["pkg:maven/org.keycloak/keycloak-core", "pkg:maven/org.keycloak/keycloak-services"],
      "aliases": [
        { "names": ["Keycloak"] },
        { "vendor": "Red Hat", "names": ["Red Hat build of Keycloak"] }
      ],
      "related": ["openjdk"],
      "images": ["quay.io/keycloak/keycloak"]
