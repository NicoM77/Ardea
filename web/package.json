{
  "name": "ardea-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ardea",
    "watch": "ng build ardea --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:unused": "knip",
    "check:comments": "node ../build/check-comments.mjs",
    "generate:api": "orval --config orval.config.ts",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.75.0",
    "intl-messageformat": "12.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "knip": "6.46.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "ng-packagr": "^22.2.0",
    "orval": "8.48.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  }
}
